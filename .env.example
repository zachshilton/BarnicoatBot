# Copy this file to .env and replace placeholder values.

# Discord bot
DISCORD_TOKEN=your_discord_bot_token_here
# The one Discord server this bot acts on.
GUILD_ID=your_discord_guild_id_here

# Web server (used for /health and the internal grant endpoint)
PORT=3000
WEB_HOST=0.0.0.0

# bb-onboarding-automation integration (subscription role sync)
# Full URL of bb-onboarding-automation's entitlements endpoint, called on a schedule
# to reconcile roles. Key must match ENTITLEMENTS_API_KEY set on that service.
ENTITLEMENTS_API_URL=https://<bb-onboarding-automation-host>/internal/entitlements
ENTITLEMENTS_API_KEY=
# Key bb-onboarding-automation must present (as `Authorization: Bearer <key>`) when it
# calls this bot's POST /internal/subscriptions/grant. Generate both keys with e.g.
# `openssl rand -hex 32`.
SUBSCRIPTION_GRANT_API_KEY=
# How often the reconciliation cron runs (node-cron syntax).
SUBSCRIPTION_SYNC_CRON=*/15 * * * *

# Role mapping - Inner Circle gets its own role only; the Social Media Success Program
# gets its own role plus the shared Deluxe Member role.
ROLE_ID_SOCIAL_MEDIA_SUCCESS_PROGRAM=
# Legacy alias for the line above, still read if it isn't set (this package was
# previously called Authority) - leave your existing value here and it keeps working.
ROLE_ID_AUTHORITY=
# Motion and Ignite are retired - no new sales - but keep these set as long as any
# member still holds those roles, otherwise reconciliation can't revoke them when
# a subscription lapses.
ROLE_ID_MOTION=
ROLE_ID_IGNITE=
ROLE_ID_INNER_CIRCLE=
ROLE_ID_DELUXE_MEMBER=
